{
  "name": "Example project",
  "description": "Example description",
  "type": "policy-set",
  "git": true,
  "build": [
    {
      "name": "masterfiles",
      "description": "Official CFEngine Masterfiles Policy Framework (MPF).",
      "tags": ["supported", "base"],
      "repo": "https://github.com/cfengine/masterfiles",
      "by": "https://github.com/cfengine",
      "version": "3.27.2",
      "commit": "5cb53724ec8b822d1cbec2e116dcdd82f3a0cd28",
      "added_by": "cfbs init",
      "steps": [
        "run EXPLICIT_VERSION=3.27.2 EXPLICIT_RELEASE=1 ./prepare.sh -y",
        "copy ./ ./"
      ]
    },
    {
      "name": "install-ansible",
      "description": "Ensure that Ansible software is installed.",
      "tags": ["experimental", "supported", "software", "ansible"],
      "repo": "https://github.com/cfengine/modules",
      "by": "https://github.com/craigcomstock",
      "version": "0.0.4",
      "commit": "83851939fca8748c373966fb2b90d367792b50e3",
      "subdirectory": "software/install-ansible",
      "added_by": "cfbs add",
      "steps": [
        "copy install-ansible.cf services/cfbs/modules/software/install-ansible/install-ansible.cf",
        "bundles install_ansible",
        "policy_files services/cfbs/modules/software/install-ansible/install-ansible.cf"
      ]
    }
  ]
}
